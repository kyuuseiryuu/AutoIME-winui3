<Window
    x:Class="AutoIME.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AutoIME.Models"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d"
    Title="AutoIME">

    <Grid RowDefinitions="Auto,*">
        <!-- System Tray Icon -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/Assets/AppIcon.ico"
            ToolTipText="AutoIME - 输入法自动切换"
            DoubleClickCommand="{x:Bind OpenWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="TrayOpenItem" Text="⚙️ 打开配置界面" Command="{x:Bind OpenWindowCommand}" Click="OnTrayOpenClick" />
                    <MenuFlyoutItem x:Name="TrayReloadItem" Text="🔄 重新加载配置" Command="{x:Bind ReloadCommand}" Click="OnTrayReloadClicked" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="TrayDebugItem" Text="💬 切换悬浮提示" Command="{x:Bind ToggleDebugCommand}" Click="OnTrayToggleDebugClicked" />
                    <ToggleMenuFlyoutItem x:Name="TrayStartupItem" Text="🚀 开机自启动" Command="{x:Bind ToggleStartupCommand}" Click="OnTrayToggleStartupClicked" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayRestartItem" Text="⚡ 重启 AutoIME" Command="{x:Bind RestartCommand}" Click="OnTrayRestartClicked" />
                    <MenuFlyoutItem x:Name="TrayExitItem" Text="❌ 退出 AutoIME" Command="{x:Bind ExitCommand}" Click="OnTrayExitClicked" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- Custom TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand & Version -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE765;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock x:Name="TxtAppTitle"
                           Text="AutoIME 多输入法自动切换"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Padding="8,2"
                        CornerRadius="10"
                        VerticalAlignment="Center">
                    <TextBlock Text="v2.0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- Drag region in center -->
            <Grid Grid.Column="1" Background="Transparent" />

            <!-- Theme & Language Switchers -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,140,0">
                <!-- Theme Radio / Selector -->
                <ComboBox x:Name="ThemeComboBox"
                          Width="130"
                          SelectionChanged="OnThemeSelectionChanged">
                    <ComboBoxItem x:Name="ThemeItemSystem" Content="💻 跟随系统" Tag="system" />
                    <ComboBoxItem x:Name="ThemeItemLight" Content="☀️ 浅色模式" Tag="light" />
                    <ComboBoxItem x:Name="ThemeItemDark" Content="🌙 深色模式" Tag="dark" />
                </ComboBox>

                <!-- Language Selector -->
                <ComboBox x:Name="LangComboBox"
                          Width="110"
                          SelectionChanged="OnLangSelectionChanged">
                    <ComboBoxItem Content="简体中文" Tag="zh" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="1" Padding="20,8,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top IME Layout Tabs -->
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Disabled"
                          Margin="0,0,0,12">
                <ItemsControl x:Name="ImeTabsControl" ItemsSource="{x:Bind ViewModel.SystemImes, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ImeInfo">
                            <ToggleButton Content="{x:Bind}"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          Click="OnImeTabClicked"
                                          Padding="14,8"
                                          CornerRadius="8">
                                <ToggleButton.ContentTemplate>
                                    <DataTemplate x:DataType="models:ImeInfo">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="Medium" />
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="10"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind AppCount, Mode=OneWay}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ToggleButton.ContentTemplate>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Action Toolbar & Search -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnCapture"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnCaptureWindowClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🎯" />
                            <TextBlock x:Name="TxtBtnCapture" Text="窗口捕获" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnBrowse" Click="OnBrowseExeClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📁" />
                            <TextBlock x:Name="TxtBtnBrowse" Text="浏览EXE" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnManual" Click="OnAddManualClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="➕" />
                            <TextBlock x:Name="TxtBtnManual" Text="手动添加" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Search Box -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="2"
                         Width="260"
                         PlaceholderText="搜索进程名或备注..."
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Header>
                        <Grid />
                    </TextBox.Header>
                </TextBox>
            </Grid>

            <!-- Rules Content Card -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Table Header -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid ColumnDefinitions="40,48,220,*,60">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{x:Bind ViewModel.IsAllSelected, Mode=TwoWay}"
                                      Click="OnSelectAllClicked"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="" />
                            <TextBlock x:Name="TxtColExe"
                                       Grid.Column="2"
                                       Text="程序进程名 (EXE)"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtColDesc"
                                       Grid.Column="3"
                                       Text="程序备注 / 窗口标题说明"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtColAction"
                                       Grid.Column="4"
                                       Text="操作"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Apps List -->
                    <ListView x:Name="AppsListView"
                              Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.CurrentFilteredApps, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppRule">
                                <Grid ColumnDefinitions="40,48,220,*,60" Padding="0,4">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              Click="OnItemCheckBoxClicked"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />

                                    <!-- App Icon -->
                                    <Border Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <Image Source="{x:Bind Icon, Mode=OneWay}"
                                               Stretch="Uniform"
                                               Width="24"
                                               Height="24" />
                                    </Border>

                                    <!-- Process Name -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind ExeName}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Description -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Description}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Delete Single Item -->
                                    <Button Grid.Column="4"
                                            Tag="{x:Bind}"
                                            Click="OnDeleteSingleItemClick"
                                            ToolTipService.ToolTip="删除"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State View -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind GetEmptyVisibility(ViewModel.CurrentFilteredApps.Count), Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B9;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="当前输入法尚未配置任何程序"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14" />
                        <TextBlock Text="点击上方【🎯 窗口捕获】、【📁 浏览EXE】或【➕ 手动添加】开始配置"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <!-- Batch Operations Bar -->
                    <Border Grid.Row="2"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSelectedCount"
                                           Text="{x:Bind GetSelectedCountText(ViewModel.SelectedCount), Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="BtnDeleteSelected"
                                        Click="OnDeleteSelectedClick"
                                        IsEnabled="{x:Bind IsGreaterThanZero(ViewModel.SelectedCount), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="❌" />
                                        <TextBlock x:Name="TxtBtnDeleteSelected" Text="删除选中" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnClearTab" Click="OnClearTabClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🗑️" />
                                        <TextBlock x:Name="TxtBtnClearTab" Text="清空本页" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Global Status InfoBar -->
            <InfoBar Grid.Row="3"
                     x:Name="GlobalInfoBar"
                     IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind GetSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
                     Margin="0,8,0,0" />

            <!-- Bottom Footer Bar -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Settings Items -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Button x:Name="BtnHotkey"
                            Click="OnHotkeyButtonClick"
                            CornerRadius="8"
                            ToolTipService.ToolTip="点击设置唤醒快捷键">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⌨️" />
                            <TextBlock Text="{x:Bind ViewModel.FormattedHotkey, Mode=OneWay}" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <CheckBox x:Name="ChkDebugMode"
                              Content="启用悬浮提示 (ToolTip)"
                              IsChecked="{x:Bind ViewModel.Settings.DebugMode, Mode=TwoWay}"
                              Click="OnDebugModeClicked"
                              VerticalAlignment="Center" />

                    <CheckBox x:Name="ChkAutoStart"
                              Content="开机自启动"
                              IsChecked="{x:Bind ViewModel.Settings.AutoStart, Mode=TwoWay}"
                              Click="OnAutoStartClicked"
                              VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnRefreshIme" Click="OnRefreshImeClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" />
                            <TextBlock x:Name="TxtBtnRefreshIme" Text="刷新输入法" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSaveConfig"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnSaveConfigClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="💾" />
                            <TextBlock x:Name="TxtBtnSaveConfig" Text="保存并应用" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
